{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Clang Instrumenter",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/clang-22",
      "args": [
        "-cc1",
        "-triple",
        "x86_64-pc-linux-gnu",
        "-emit-obj",
        "-dumpdir",
        "/dev/null-",
        "-disable-free",
        "-clear-ast-before-backend",
        "-disable-llvm-verifier",
        "-discard-value-names",
        "-main-file-name",
        "example.cpp",
        "-mrelocation-model",
        "pic",
        "-pic-level",
        "2",
        "-pic-is-pie",
        "-mframe-pointer=all",
        "-fmath-errno",
        "-ffp-contract=on",
        "-fno-rounding-math",
        "-mconstructor-aliases",
        "-funwind-tables=2",
        "-target-cpu",
        "x86-64",
        "-tune-cpu",
        "generic",
        "-debugger-tuning=gdb",
        "-fdebug-compilation-dir=/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test",
        "-fcoverage-compilation-dir=/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test",
        "-resource-dir",
        "/usr/lib/clang/22",
        "-internal-isystem",
        "/usr/bin/../lib64/gcc/x86_64-pc-linux-gnu/16/../../../../include/c++/16",
        "-internal-isystem",
        "/usr/bin/../lib64/gcc/x86_64-pc-linux-gnu/16/../../../../include/c++/16/x86_64-pc-linux-gnu",
        "-internal-isystem",
        "/usr/bin/../lib64/gcc/x86_64-pc-linux-gnu/16/../../../../include/c++/16/backward",
        "-internal-isystem",
        "/usr/lib/clang/22/include",
        "-internal-isystem",
        "/usr/local/include",
        "-internal-isystem",
        "/usr/bin/../lib64/gcc/x86_64-pc-linux-gnu/16/../../../../x86_64-pc-linux-gnu/include",
        "-internal-externc-isystem",
        "/include",
        "-internal-externc-isystem",
        "/usr/include",
        "-std=c++17",
        "-fdeprecated-macro",
        "-ferror-limit",
        "19",
        "-stack-protector",
        "2",
        "-fgnuc-version=4.2.1",
        "-fskip-odr-check-in-gmf",
        "-fcxx-exceptions",
        "-fexceptions",
        "-load",
        "../src/build/Instrumenter.so",
        "-plugin-arg-instrumenter",
        "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test/.debug",
        "-faddrsig",
        "-fdwarf2-cfi-asm",
        "-o",
        "/tmp/example-4bd6da.o",
        "-x",
        "c++",
        "main.cpp",
        "example.cpp"
      ],
      // clang++ -fplugin=../src/build/Instrumenter.so -std=c++17 example.cpp -fplugin-arg-instrumenter-/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test/.debug -o /dev/null -### 2>&1 | grep -- '"-cc1"' | python3 -c 'import sys,shlex,json; print(json.dumps(shlex.split(sys.stdin.read())[1:]))' | c
      "cwd": "${workspaceFolder}/instrumenters/cpp/test",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [{ "text": "set breakpoint pending on" }]
    },
    {
      "name": "Launch index.js",
      "program": "${file}",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "args": ["-p", "js/test", "node", "test/main.js"]
    },
    {
      "name": "Launch instrumenter (js)",
      "program": "/home/alex/Desktop/VSC/debugger/instrumenters/js/src/index.ts",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "args": [
        "instrument",
        "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test",
        "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test/${fileBasename}",
        "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test/.debug/${fileBasename}",
        "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test/.debug"
        // "/home/alex/Desktop/VSC/debugger/instrumenters/js/test",
        // "/home/alex/Desktop/VSC/debugger/instrumenters/js/test/${fileBasename}",
        // "/home/alex/Desktop/VSC/debugger/instrumenters/js/test/.debug/${fileBasename}",
        // "/home/alex/Desktop/VSC/debugger/instrumenters/js/test/.debug"
      ]
    },
    {
      "name": "Launch cli",
      "program": "/home/alex/Desktop/VSC/debugger/debugger/cli.ts",
      "cwd": "/home/alex/Desktop/VSC/debugger/instrumenters/cpp/test",
      "request": "launch",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "args": ["./cmake.sh && ./build/app"]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "args": ["--exe", "cpp/test/main.o"],
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
