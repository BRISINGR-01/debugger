{
  "name": "trace-viewer",
  "displayName": "Trace Viewer",
  "description": "Displays variable and expression values inline from an execution trace log (declare/call/enter/return/throw events).",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "traceViewer.loadLog",
        "title": "Trace Viewer: Load Trace Log...",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "traceViewer.stepForward",
        "title": "Trace Viewer: Step Forward",
        "icon": "$(chevron-right)"
      },
      {
        "command": "traceViewer.stepBackward",
        "title": "Trace Viewer: Step Backward",
        "icon": "$(chevron-left)"
      },
      {
        "command": "traceViewer.jumpToStart",
        "title": "Trace Viewer: Jump to Start",
        "icon": "$(debug-reverse-continue)"
      },
      {
        "command": "traceViewer.jumpToEnd",
        "title": "Trace Viewer: Jump to End",
        "icon": "$(debug-continue)"
      },
      {
        "command": "traceViewer.pickTime",
        "title": "Trace Viewer: Jump to Event..."
      },
      {
        "command": "traceViewer.toggleInline",
        "title": "Trace Viewer: Toggle Inline Values"
      },
      {
        "command": "traceViewer.clear",
        "title": "Trace Viewer: Clear Trace"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "traceViewer.stepForward",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.stepBackward",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.jumpToStart",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.jumpToEnd",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.pickTime",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.toggleInline",
          "when": "traceViewer.hasTrace"
        },
        {
          "command": "traceViewer.clear",
          "when": "traceViewer.hasTrace"
        }
      ],
      "view/title": [
        {
          "command": "traceViewer.loadLog",
          "when": "view == traceViewer.timeline",
          "group": "navigation"
        },
        {
          "command": "traceViewer.jumpToStart",
          "when": "view == traceViewer.timeline && traceViewer.hasTrace",
          "group": "navigation"
        },
        {
          "command": "traceViewer.stepBackward",
          "when": "view == traceViewer.timeline && traceViewer.hasTrace",
          "group": "navigation"
        },
        {
          "command": "traceViewer.stepForward",
          "when": "view == traceViewer.timeline && traceViewer.hasTrace",
          "group": "navigation"
        },
        {
          "command": "traceViewer.jumpToEnd",
          "when": "view == traceViewer.timeline && traceViewer.hasTrace",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "traceViewer.timeline",
          "name": "Trace Timeline"
        }
      ]
    },
    "configuration": {
      "title": "Trace Viewer",
      "properties": {
        "traceViewer.decorationColor": {
          "type": "string",
          "default": "",
          "description": "Optional custom color (hex) for inline trace decorations. Leave empty to use the theme's codeLens color."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "../server"
  ]
}
